# Neon Postgres. Copy this from Neon Console > Connect. Never expose it client-side.
DATABASE_URL=
# Neon Console > Auth > Configuration > Auth URL.
NEON_AUTH_BASE_URL=
# Generate at least 32 random characters. Keep stable in each deployed environment.
NEON_AUTH_COOKIE_SECRET=
# Server-only HMAC secret for daily fields and ranked-run tokens.
RUN_TOKEN_SECRET=
# Local development origin. Set to https://rigyadh.buzz in Netlify Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
